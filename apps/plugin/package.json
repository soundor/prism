{
  "name": "prism",
  "version": "0.0.0",
  "private": true,
  "description": "Soundor Prism, a 24-band parametric VST3 and web equalizer.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "bench:rust": "cargo test --release --locked --manifest-path lib/Cargo.toml --test benchmark -- --ignored --nocapture",
    "build:vst3": "soundor build vst3",
    "build:web": "soundor build web",
    "dev:web": "soundor dev web",
    "doctor": "soundor doctor",
    "format:rust": "cargo fmt --manifest-path lib/Cargo.toml --check",
    "gen": "soundor gen",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rust": "cargo test --locked --manifest-path lib/Cargo.toml",
    "test:vst3": "vitest run --config vitest.vst3.config.ts",
    "test:watch": "vitest watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tests.json && tsc -p tsconfig.node.json && tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "@soundor/components": "0.6.0",
    "@soundor/icons": "0.3.0",
    "@soundor/react": "0.21.1",
    "@soundor/vst3-runtime": "0.2.1",
    "@soundor/web-runtime": "0.18.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@soundor/config": "0.21.1",
    "@soundor/testing-library": "0.21.1",
    "@soundor/vitest": "0.21.1",
    "@soundor/vst3-host": "0.2.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "soundor": "0.21.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "vitest-environment-soundor": "0.21.0"
  }
}
